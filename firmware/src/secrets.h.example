/* Copy to secrets.h (git-ignored) and fill in. */
#pragma once

/* Backend that receives CSI presence features. */
#define PRESENCE_API_URL   "https://echo-maps-api.onrender.com/api/presence/ingest"

/* Must equal PRESENCE_INGEST_KEY on the Render service (Environment tab). */
#define PRESENCE_DEVICE_KEY "paste-render-PRESENCE_INGEST_KEY-here"

/* Public area this unit monitors. Guest-room names (Room 304, Suite 2, ...)
 * are rejected by the backend: public/common areas only. */
#define PRESENCE_ZONE_NAME "Hallway"
